# Тестовый бот на Mac: скопируйте в .env.test и запускайте npm run dev:test.
# Читается только этот файл, основной .env не трогается. Если токен окажется
# от боевого бота, запуск остановится сам (src/test-bot-guard.js).

TEST_BOT=true
# Своя база: папка data-test/ рядом с кодом, в git не попадает.
GIVEAWAY_DATA_DIR=data-test

# Токен и имя тестового бота из @BotFather (не @roller_official_bot!)
BOT_TOKEN=
BOT_USERNAME=

# Ваш числовой id в Telegram (узнать: @userinfobot)
ADMIN_IDS=
TIMEZONE=Europe/Moscow

# Порт 3001, чтобы не мешать дизайн-серверу на 3000.
# WEB_PUBLIC_URL — https-адрес туннеля к этому порту.
WEB_PORT=3001
WEB_PUBLIC_URL=

# Mini App участия, созданный в @BotFather (/newapp) с адресом {WEB_PUBLIC_URL}/join/app
JOIN_MINI_APP_SHORT_NAME=join

# Посты сразу в канал, без пересылки через личку владельца.
DRAW_POST_PREMIUM_EMOJI=false

# Вход в локальную админку {WEB_PUBLIC_URL}/admin
ADMIN_DASHBOARD_LOGIN=admin
ADMIN_DASHBOARD_PASSWORD=
